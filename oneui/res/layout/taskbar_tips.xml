<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:id="@id/tips_layer" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout android:id="@id/tips_container" android:background="@drawable/taskbar_tips_background" android:layout_width="@dimen/taskbar_tips_width" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/taskbar_tips_margin_bottom" android:layout_alignParentBottom="true" android:layout_centerHorizontal="true" android:elevation="@dimen/taskbar_tips_elevation">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="@dimen/taskbar_tips_padding_horizontal" android:paddingVertical="@dimen/taskbar_tips_padding_vertical">
            <com.airbnb.lottie.LottieAnimationView android:id="@id/lottie" android:layout_width="match_parent" android:layout_height="@dimen/taskbar_tips_lottie_height" android:layout_marginBottom="@dimen/taskbar_tips_lottie_margin_bottom" app:lottie_autoPlay="true" app:lottie_loop="true" app:lottie_speed="1.0" />
            <TextView android:textAppearance="@style/SecBold" android:textSize="@dimen/taskbar_tips_title_size" android:textColor="@color/taskbar_tips_title_color" android:id="@id/title" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:textAppearance="@style/SecRegular" android:textSize="@dimen/taskbar_tips_contents_size" android:textColor="@color/taskbar_tips_contents_color" android:id="@id/contents" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
        <ImageView android:id="@id/close" android:background="@drawable/ripple_bg_dialog_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="@dimen/taskbar_tips_close_button_margin_top" android:src="@drawable/cancel_close" android:layout_alignParentTop="true" android:layout_alignParentEnd="true" android:tooltipText="@string/taskbar_close_tips" />
    </RelativeLayout>
</RelativeLayout>
