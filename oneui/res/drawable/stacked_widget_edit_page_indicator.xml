<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="ring" android:useLevel="false" android:innerRadius="0.0dp" android:thickness="@dimen/stacked_widget_edit_page_indicator_thickness">
            <solid android:color="@color/page_selected_indicator" />
        </shape>
    </item>
    <item>
        <shape android:shape="ring" android:useLevel="false" android:innerRadius="0.0dp" android:thickness="@dimen/stacked_widget_edit_page_indicator_thickness">
            <solid android:color="@color/page_unselected_indicator" />
        </shape>
    </item>
</selector>
