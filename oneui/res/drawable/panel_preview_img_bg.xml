<?xml version="1.0" encoding="utf-8"?>
<ripple android:color="@color/ripple_mask_color"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
            <corners android:radius="@dimen/settings_edge_panel_item_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/panel_preview_img_bg_color" />
            <corners android:radius="@dimen/settings_edge_panel_item_radius" />
            <stroke android:width="1.0px" android:color="@color/panel_preview_img_bg_stroke_color" />
        </shape>
    </item>
</ripple>
