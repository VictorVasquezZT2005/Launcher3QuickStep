<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <inset android:insetTop="@dimen/multi_select_panel_button_vertical_margin" android:insetBottom="@dimen/multi_select_panel_button_vertical_margin">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/multi_select_panel_drawable_radius" />
                <stroke android:width="@dimen/multi_select_panel_focused_stroke_width" android:color="@color/multi_select_panel_focused_stroke_color" />
            </shape>
        </inset>
    </item>
    <item android:state_hovered="true">
        <inset android:insetTop="@dimen/multi_select_panel_button_vertical_margin" android:insetBottom="@dimen/multi_select_panel_button_vertical_margin">
            <shape android:shape="rectangle">
                <solid android:color="@color/sticker_button_ripple_color" />
                <corners android:radius="@dimen/taskbar_tips_background_radius" />
            </shape>
        </inset>
    </item>
</selector>
