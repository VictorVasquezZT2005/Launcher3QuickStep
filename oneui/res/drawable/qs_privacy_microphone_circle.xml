<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="center" android:id="@id/background">
        <shape android:shape="oval">
            <size android:height="@dimen/qs_privacy_circle_size" android:width="@dimen/qs_privacy_circle_size" />
            <solid android:color="@color/qs_privacy_circle" />
            <corners android:radius="8.0dp" />
            <stroke android:width="@dimen/qs_privacy_circle_stroke_width" android:color="@color/qs_privacy_circle_stroke" />
        </shape>
    </item>
    <item android:gravity="center" android:id="@id/icon" android:height="@dimen/qs_privacy_icon_height" android:width="@dimen/qs_privacy_icon_width" android:drawable="@drawable/qs_privacy_microphone_icon" />
</layer-list>
