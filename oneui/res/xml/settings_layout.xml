    <PreferenceCategory android:title="Test Mode" app:isPreferenceVisible="false">
        <SwitchPreferenceCompat android:title="@string/search_settings_test_sse_no_support" android:key="key_test_sse_no_support" app:isPreferenceVisible="false" />
        <SwitchPreferenceCompat android:title="@string/search_settings_test_show_raw_wallpaper" android:key="key_test_show_wallpaper_raw" app:isPreferenceVisible="false" />
        <SwitchPreferenceCompat android:title="@string/search_settings_test_show_semantic_score" android:key="key_test_show_semantic_score" app:isPreferenceVisible="false" />
        <SeekBarPreference android:title="@string/search_settings_test_threshold" android:key="key_test_recall_threshold" app:isPreferenceVisible="false" />
        <SwitchPreferenceCompat android:title="@string/search_settings_test_show_recall_card" android:key="key_test_show_recall_card" app:isPreferenceVisible="false" />
