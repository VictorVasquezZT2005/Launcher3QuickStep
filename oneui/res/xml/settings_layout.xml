        <SwitchPreferenceCompat android:title="@string/search_settings_show_hidden_apps" android:key="key_show_hidden_apps" />
        <SwitchPreferenceCompat android:title="@string/search_settings_show_downloads_and_screenshots" android:key="key_show_downloads_screenshots" />
        <SwitchPreferenceCompat android:title="@string/search_settings_show_search_documents" android:key="key_show_search_documents" app:isPreferenceVisible="false" />
    </PreferenceCategory>
    <PreferenceCategory app:isPreferenceVisible="false">
        <Preference android:title="@string/search_settings_customization_service" android:key="key_customization_service" app:isPreferenceVisible="false" />
        <Preference android:title="@string/search_settings_personal_data_intelligence" android:key="key_personal_data_intelligence" app:isPreferenceVisible="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/search_settings_category_privacy" app:isPreferenceVisible="false">
        <Preference android:title="@string/search_settings_privacy_policy" android:key="key_privacy_notice" app:isPreferenceVisible="false" />
