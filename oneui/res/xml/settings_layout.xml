<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen android:title="@string/search_settings_title" android:key="setting_title_privacy"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory android:title="@string/search_settings_header_main_view" android:key="pref_category_apps">
        <SwitchPreferenceCompat android:title="@string/search_settings_show_suggested_apps" android:key="key_show_suggested_apps" />
        <SwitchPreferenceCompat android:title="@string/search_settings_show_suggested_settings" android:key="key_show_suggested_settings" />
        <SwitchPreferenceCompat android:title="@string/search_settings_show_web_history" android:key="key_show_suggested_chrome_doc" app:isPreferenceVisible="false" />
        <SwitchPreferenceCompat android:title="@string/search_settings_show_recent_searches" android:key="key_show_search_history" />
        <SwitchPreferenceCompat android:title="@string/search_settings_show_popular_searches" android:key="key_show_hot_words" app:isPreferenceVisible="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/search_settings_header_search_results" android:key="pref_category_apps">
        <Preference android:title="@string/search_settings_search_locations" android:key="key_choose_apps_to_search_in" app:isPreferenceVisible="false" />
        <SwitchPreferenceCompat android:title="@string/search_settings_show_suggested_content" android:key="key_show_search_suggestion" />
        <SwitchPreferenceCompat android:title="@string/search_settings_show_app_options_searches" android:key="key_show_app_options_searches" />
