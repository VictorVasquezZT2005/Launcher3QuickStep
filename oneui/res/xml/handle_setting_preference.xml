        <Preference android:layout="@layout/preference_divider" />
    </androidx.preference.PreferenceCategory>
    <androidx.preference.PreferenceCategory android:layout="@layout/one_line_list_layout" android:title="@string/settings_handle_width" android:key="@string/edge_handler_preference_width_category">
        <com.samsung.app.honeyspace.edge.edgepanel.ui.setting.presentation.LevelSeekBarPreference android:max="2" android:key="@string/edge_handler_preference_width_key" app:leftTitle="@string/settings_handle_width_thin" app:rightTitle="@string/settings_handle_width_thick" app:title="@string/settings_handle_width" />
    </androidx.preference.PreferenceCategory>
